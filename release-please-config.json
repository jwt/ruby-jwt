{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "ruby",
  "packages": {
    ".": {
      "version-file": "lib/jwt/version.rb",
      "extra-files": ["lib/jwt/version.rb"],
      "include-commit-authors": true,
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Fixes and enhancements" },
        { "type": "perf", "section": "Fixes and enhancements" },
        { "type": "revert", "section": "Reverts" }
      ]
    }
  }
}
